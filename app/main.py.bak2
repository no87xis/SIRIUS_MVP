# Ленивые импорты роутеров для быстрого старта (MVP: без QR)
def _import_routers():
    """Ленивый импорт роутеров"""
    from .routers import (
        web_public, web_products, web_orders, web_analytics, 
        web_admin_panel, api, web_shop, shop_api, shop_admin, 
        delivery_payment, delivery_notifications
    )
    return {
        'web_public': web_public,
        'web_products': web_products,
        'web_orders': web_orders,
        'web_analytics': web_analytics,
        'web_admin_panel': web_admin_panel,
        'api': api,
        'web_shop': web_shop,
        'shop_api': shop_api,
        'shop_admin': shop_admin,
        'delivery_payment': delivery_payment,
        'delivery_notifications': delivery_notifications
    }